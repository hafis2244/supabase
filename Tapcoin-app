-- Function to update updated_at
CREATE OR REPLACE FUNCTION update_updated_at_column()
RETURNS TRIGGER AS $$
BEGIN
    NEW.updated_at = NOW();
    RETURN NEW;
END;
$$ language 'plpgsql';

-- Trigger for updated_at
CREATE TRIGGER update_users_updated_at BEFORE UPDATE ON users
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- Function to generate referral code
CREATE OR REPLACE FUNCTION generate_referral_code(username TEXT)
RETURNS TEXT AS $$
BEGIN
    RETURN 'TC_' || UPPER(username) || '_' || FLOOR(RANDOM() * 10000)::TEXT;
END;
$$ LANGUAGE plpgsql;

-- Function to check and reset daily taps
CREATE OR REPLACE FUNCTION check_daily_reset(user_id UUID)
RETURNS BOOLEAN AS $$
DECLARE
    user_record RECORD;
    today DATE := CURRENT_DATE;
BEGIN
    SELECT * INTO user_record FROM users WHERE id = user_id;
    
    IF user_record.last_reset_date < today THEN
        UPDATE users 
        SET taps_today = 0, last_reset_date = today 
        WHERE id = user_id;
        RETURN TRUE;
    END IF;
    
    RETURN FALSE;
END;
$$ LANGUAGE plpgsql;
